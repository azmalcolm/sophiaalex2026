---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PageHero from '../components/PageHero.astro';
import ContactBlock from '../components/ContactBlock.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Staying in Monforte D'Alba — Sophia & Alex 2026">
  <Nav />
  <PageHero video="/videos/689dd042d870290e0b7d1c17_12.webm">Staying in<br />Monforte D'Alba</PageHero>

  <section class="section-cream monforte">

    <div class="content-wrap monforte__upper">
      <!-- Intro -->
      <div class="intro prose-wrap" data-fade>
        <p class="intro__body">
          Monforte d'Alba has a variety of charming places to stay, all close to Villa Beccaris.
          From small hotels and B&Bs to countryside guesthouses, there are plenty of comfortable
          options within walking or short driving distance. Most have beautiful views of the hills
          and vineyards, and the village itself is compact and easy to get around.
        </p>
      </div>
    </div>

    <div class="content-wrap monforte__lower">
      <!-- Activities -->
      <div class="activities" data-stagger>

        <!-- Local Food Spots -->
        <div class="activity">
          <div class="activity__content">
            <h3 class="activity__title display">Local Food Spots</h3>
            <div class="activity__body">
              <p>Gelato at <em>Cremeria Monforte</em><br />
              Lunch at <em>Osteria La Salita</em><br />
              Dinner at <em>Le Case della Saracca</em><br />
              Dinner at <em>Osteria dei Càtari</em><br />
              Wine bar at <em>Enoteca Rocca</em><br />
              Wine bar at <em>Barolo Bar</em></p>
              <p><a href="https://maps.app.goo.gl/8ePSK2yznYrRwQQCA" target="_blank" rel="noopener">Find more local food</a> →</p>
            </div>
          </div>
          <div class="activity__photo">
            <img src="/images/Schermata-2023-09-04-alle-12.15.54-03-1.jpg" alt="" loading="lazy" />
          </div>
        </div>

        <!-- Wine Tastings -->
        <div class="activity activity--flip">
          <div class="activity__content">
            <h3 class="activity__title display">Wine Tastings &amp;<br />Vineyard Tours</h3>
            <div class="activity__body">
              <p>Elio Grasso - benchmark Barolo producer.<br />
              Costa di Bussia - panoramic tasting terrace.<br />
              Conterno Fantino - modern style vineyards.<br />
              G.D. Vajra (Barolo) - warm family-run atmosphere.<br />
              Pio Cesare (Alba) - cellars beneath the old town.</p>
            </div>
          </div>
          <div class="activity__photo">
            <img src="/images/Schermata-2023-09-04-alle-12.15.54-02-1.jpg" alt="" loading="lazy" />
          </div>
        </div>

        <!-- Day Trips -->
        <div class="activity">
          <div class="activity__content">
            <h3 class="activity__title display">Day Trips</h3>
            <div class="activity__body">
              <p>
                <strong>Barolo (5 km)</strong> — Visit the WiMu Wine Museum, stroll through the
                castle gardens, and explore the charming village lanes.
              </p>
              <p>
                <strong>La Morra (12 km)</strong> — Take in the panoramic views from the
                Belvedere, see the colourful Cappella del Barolo, or rent e-bikes to ride
                through the vineyards.
              </p>
              <p>
                <strong>Serralunga d'Alba (9 km)</strong> — Tour the impressive Medieval Castle
                and enjoy the surrounding views.
              </p>
            </div>
          </div>
          <div class="activity__photo">
            <img src="/images/DSCF6747_02.jpg" alt="" loading="lazy" />
          </div>
        </div>

        <!-- Jazz Festival -->
        <div class="activity activity--flip">
          <div class="activity__content">
            <h3 class="activity__title display">Monforte Jazz<br />Festival</h3>
            <div class="activity__body">
              <p>
                An open-air jazz festival held in Monforte's natural amphitheatre during July.
                The exact dates are yet to be confirmed — stay tuned.
              </p>
              <p>
                <a href="https://www.monfortinjazz.it/" target="_blank" rel="noopener">Monforte Jazz Festival</a> →
              </p>
            </div>
          </div>
          <div class="activity__photo">
            <img src="/images/Screenshot 2025-09-22 at 22.25.44.png" alt="" loading="lazy" />
          </div>
        </div>

        <!-- Cooking Classes -->
        <div class="activity">
          <div class="activity__content">
            <h3 class="activity__title display">Cooking Classes &amp;<br />Truffle Experiences</h3>
            <div class="activity__body">
              <p>
                Cooking classes and truffle hunts are popular activities in the area — and they
                often book up quickly during summer. If this sounds like something for you, we
                recommend arranging it in advance.
              </p>
              <p>
                <a href="https://www.getyourguide.com/en-au/-l129783/" target="_blank" rel="noopener">Find tours on GetYourGuide</a> →
              </p>
            </div>
          </div>
          <div class="activity__photo">
            <img src="/images/IMG_0866.jpg" alt="" loading="lazy" />
          </div>
        </div>

      </div>
    </div>

  </section>

  <!-- Full-width section break -->
  <div class="page-break" aria-hidden="true">
    <img src="/images/DSCF67662.png" alt="" />
  </div>

  <!-- Hotel Villa Beccaris — featured card -->
  <section class="section-cream">
    <div class="content-wrap monforte__upper">

      <div class="hotel-card-wrap" data-fade>
        <div class="hotel-card">
          <p class="label hotel-card__eyebrow">Our venue</p>
          <div class="hotel-card__inner">
            <h2 class="hotel-card__name display">Hotel Villa Beccaris</h2>
            <p class="hotel-card__desc">
              We would love for as many of our guests as possible to stay with us at Hotel Villa
              Beccaris, where the wedding will take place. A number of rooms will be pre-assigned
              to close family &amp; the wedding party, and the remaining rooms can be booked
              directly with the hotel on a first come, first served basis.
            </p>
            <div class="hotel-card__tip">
              <p>
                Email <a href="mailto:villa@villabeccaris.it">villa@villabeccaris.it</a> and
                mention you're attending Sophia &amp; Alex's wedding on 4 July 2026.
              </p>
            </div>
            <p class="hotel-card__note">
              To secure your booking, simply provide your credit card details for the full
              (non-refundable) payment. Once payment is processed, you'll get a confirmation
              email directly from the hotel.
            </p>
            <div class="hotel-card__tip">
              <p>
                <a href="/rooms-at-beccaris">View exclusive room rates for wedding guests</a> →
              </p>
            </div>
          </div>
        </div>
        <div class="hotel-card-photos">
          <img src="/images/DSCF6698.png" alt="Hotel Villa Beccaris" loading="lazy" />
          <img src="/images/DSCF6702.png" alt="Hotel Villa Beccaris" loading="lazy" />
        </div>
      </div>

      <!-- Hotel listings -->
      <div class="hotels" data-stagger>
        <div class="hotel-row">
          <div class="hotel-row__name"><a href="/rooms-at-beccaris">Hotel Villa Beccaris</a></div>
          <div class="hotel-row__meta">
            <span class="hotel-row__price">€240–320 / night</span>
            <span class="hotel-row__capacity">43 guests</span>
          </div>
          <p class="hotel-row__desc">The wedding venue and number one place to enjoy our big day.</p>
        </div>
        <div class="hotel-row">
          <div class="hotel-row__name"><a href="https://www.booking.com/Share-E7lCD0" target="_blank" rel="noopener">La Ribezza Boutique Hotel</a></div>
          <div class="hotel-row__meta">
            <span class="hotel-row__price">€350–450 / night</span>
            <span class="hotel-row__capacity">25 guests</span>
          </div>
          <p class="hotel-row__desc">A modern luxury boutique hotel directly opposite Hotel Villa Beccaris.</p>
        </div>
        <div class="hotel-row">
          <div class="hotel-row__name"><a href="https://www.booking.com/Share-6wlg0l" target="_blank" rel="noopener">Hotel Felicin</a></div>
          <div class="hotel-row__meta">
            <span class="hotel-row__price">€250–300 / night</span>
            <span class="hotel-row__capacity">40 guests</span>
          </div>
          <p class="hotel-row__desc">Family-run hotel with comfortable rooms and just steps from the main square.</p>
        </div>
        <div class="hotel-row">
          <div class="hotel-row__name"><a href="https://www.booking.com/Share-nacbsb" target="_blank" rel="noopener">Le Case della Saracca</a></div>
          <div class="hotel-row__meta">
            <span class="hotel-row__price">€200 / night</span>
            <span class="hotel-row__capacity">12 guests</span>
          </div>
          <p class="hotel-row__desc">A medieval guesthouse in Monforte's center with unique stone-carved rooms and lots of character.</p>
        </div>
        <div class="hotel-row">
          <div class="hotel-row__name"><a href="https://www.booking.com/Share-zgtqOJ" target="_blank" rel="noopener">Hotel Il Grappolo D'Oro</a></div>
          <div class="hotel-row__meta">
            <span class="hotel-row__price">€190 / night</span>
            <span class="hotel-row__capacity">40 guests</span>
          </div>
          <p class="hotel-row__desc">A simple, traditional hotel in the town center, offering good value and easy access.</p>
        </div>
      </div>

      <ContactBlock />
    </div>
  </section>

  <Footer />
</Base>

<style>
  .monforte__upper,
  .monforte__lower {
    display: flex;
    flex-direction: column;
    gap: var(--sp-10);
    padding-block: var(--sp-10);
  }

  /* ── Intro ── */
  .intro__body {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    font-weight: 300;
    line-height: 1.85;
  }

  /* ── Featured hotel card ── */
  .hotel-card-wrap {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .hotel-card {
    position: relative;
    z-index: 1;
    margin-inline: auto;
margin: var(--sp-4);
    background: rgba(236, 232, 223, 0.6);
    background-image: url('/images/grain.jpg');
    background-size: 200px;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    padding: var(--sp-6) var(--sp-6);
    overflow: visible;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-5);
  }

  .hotel-card__ornament {
    width: 160px;
    margin-inline: auto;
    flex-shrink: 0;
    pointer-events: none;
  }

  .hotel-card__ornament img {
    width: 100%;
    height: auto;
    display: block;
    opacity: 0.45;
  }

  .hotel-card__ornament--top {
    margin-top: -42px;
    margin-bottom: var(--sp-2);
  }

  .hotel-card__ornament--bottom {
    margin-bottom: -44px;
    margin-top: var(--sp-2);
    transform: scaleY(-1);
  }

  .hotel-card__eyebrow {
    opacity: 0.45;
    text-align: center;
  }

  .hotel-card__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-5);
    max-width: var(--content-width);
    width: 100%;
  }

  .hotel-card__name {
    font-size: clamp(2rem, 4vw, 3.5rem);
    color: var(--text-dark);
    font-style: italic;
    text-align: center;
  }

  .hotel-card__desc {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    font-weight: 300;
    line-height: 1.85;
    text-align: left;
  }

  .hotel-card__tip {
    background: var(--cream-dark);
    border-radius: var(--radius-sm);
    padding: var(--sp-4) var(--sp-5);
    width: 100%;
  }

  .hotel-card__tip p {
    font-family: var(--font-body);
    font-size: var(--text-body);
    font-weight: 300;
    line-height: 1.85;
    text-align: left;
  }

  .hotel-card__tip a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hotel-card__note {
    font-family: var(--font-body);
    font-size: var(--text-body);
    font-weight: 300;
    line-height: 1.85;
    text-align: left;
  }

  .hotel-card-photos {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    z-index: 0;
  }

  .hotel-card-photos img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Hotel listings ── */
  .hotels {
    display: flex;
    flex-direction: column;
  }

  .hotel-row {
    padding-block: var(--sp-4);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .hotel-row:last-child {
  }

  .hotel-row--header {
    padding-block: 0 var(--sp-5);
  }

  .hotel-row__section-label {
    opacity: 0.4;
    text-align: center;
  }

  .hotel-row__name {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hotel-row__name a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hotel-row__meta {
    display: flex;
    gap: var(--sp-4);
    align-items: center;
  }

  .hotel-row__price {
    font-family: var(--font-label);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.45;
  }

  .hotel-row__capacity {
    font-family: var(--font-label);
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.3;
  }

  .hotel-row__desc {
    font-family: var(--font-body);
    font-size: var(--text-body);
    font-weight: 300;
    line-height: 1.75;
    opacity: 0.7;
  }

  /* ── Full-width section break ── */
  .page-break {
    width: 100%;
    height: 55vh;
    min-height: 380px;
    overflow: hidden;
  }

  .page-break img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* ── Activities ── */
  .activities {
    display: flex;
    flex-direction: column;
  }

  .activity {
    padding-block: var(--sp-4);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-10);
    align-items: center;
  }

  .activity:last-child {
  }

  /* Flip: photo left, content right */
  .activity--flip .activity__photo {
    order: -1;
  }

  .activity__content {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  .activity__title {
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    font-style: italic;
    font-weight: 100;
    color: var(--text-dark);
    line-height: 1.2;
  }

  .activity__body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .activity__body p {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    font-weight: 300;
    line-height: 1.85;
    opacity: 0.8;
  }

  .activity__body em {
    font-style: italic;
  }

  .activity__body a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .activity__photo {
    overflow: hidden;
    border-radius: var(--radius-md);
    min-height: 340px;
    align-self: stretch;
  }

  .activity__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 700px) {
  .hotel-card {
	margin: var(--sp-0);
    box-shadow: var(--shadow-card);
padding: var(--sp-4) var(--sp-2);

    }

    .hotel-card__inner {
      grid-template-columns: 1fr;
    }

.hotel-card-photos {
     display: none;
    }

    .hotel-card__gallery {
      grid-template-columns: 1fr 1fr;
      min-height: 200px;
    }

    .activity {
      grid-template-columns: 1fr;
      gap: var(--sp-5);
    }

    .activity--flip .activity__photo,
    .activity__photo {
      order: -1;
      min-height: auto;
max-width:100%;
aspect-ratio: 1;
    }
  }
</style>
